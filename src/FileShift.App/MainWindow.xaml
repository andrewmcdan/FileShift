<Window x:Class="FileShift.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FileShift — File Converter" Icon="Assets/FileShift.ico" Width="1120" Height="790"
        MinWidth="960" MinHeight="710" WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Segoe UI" Foreground="#192538"
        AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragged" Closing="WindowClosing">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24364B"/>
      <Setter Property="BorderBrush" Value="#DAE1E9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#087F8C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#087F8C"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DAE1E9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,9"/><Setter Property="MinWidth" Value="180"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#65768A"/></Style>
    <Style x:Key="QueueCellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="9,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#E2E7EE"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#122234">
      <Grid Margin="22,30,18,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><Image Source="Assets/FileShift.Mark.png" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="FileShift logo"/>
          <TextBlock Text="FileShift" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="A new format. Same file." Foreground="#92A6BB" Margin="0,9,0,24" FontSize="11"/></StackPanel>
        <StackPanel Grid.Row="1">
          <Button Content="Conversion queue" Click="ShowQueue" Background="#244357" Foreground="White" BorderBrush="#244357" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
          <Button Content="Engines &amp; setup" Click="ShowSettings" Background="#122234" Foreground="#CAD6E2" BorderBrush="#344557" Margin="0"/>
          <TextBlock Text="LOCAL CONVERSION" FontSize="10" Foreground="#7890A7" Margin="0,38,0,14"/>
          <TextBlock x:Name="EngineSummary" Foreground="#BECBD8" TextWrapping="Wrap" FontSize="12" LineHeight="25"/>
        </StackPanel>
        <StackPanel Grid.Row="3"><Border Background="#1D3547" CornerRadius="8" Padding="12"><TextBlock Text="Close the window to keep&#10;FileShift in your system tray." Foreground="#BECBD8" FontSize="11" TextWrapping="Wrap"/></Border>
          <TextBlock Text="FILE CONVERTER  /  0.1" Foreground="#7890A7" FontSize="9" Margin="0,18,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,28,30,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,23"><StackPanel><TextBlock x:Name="PageTitle" Text="Your conversion workspace" FontSize="27" FontWeight="SemiBold"/>
        <TextBlock x:Name="PageSubtitle" Text="Drop files, choose a format, and let FileShift handle the rest." Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
      </Grid>
      <Grid x:Name="QueuePage" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel><TextBlock Text="NEW CONVERSION" Foreground="#087F8C" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ Add files" Click="AddFiles" Padding="12,7"/><Button Content="Clear" Click="ClearFiles" Padding="12,7" Margin="0"/></StackPanel>
            </DockPanel>
            <Border Background="#F4F8FA" CornerRadius="8" Padding="14" Margin="0,14,0,16" MinHeight="72">
              <StackPanel><TextBlock x:Name="SelectionTitle" Text="Drop your files here" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="SelectionDetail" Text="Documents, images, audio, video, and more" Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="Convert to" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="TargetFormat" SelectionChanged="TargetChanged" MinWidth="0"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Save to · empty = beside each original" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/>
                <DockPanel><Button Content="…" DockPanel.Dock="Right" Click="BrowseOutput" Padding="10,8" Margin="5,0,0,0" ToolTip="Choose output folder"/><TextBox x:Name="OutputFolder" ToolTip="Leave empty to save beside each source file"/></DockPanel></StackPanel>
              <Button x:Name="ConvertButton" Grid.Column="2" Content="Convert files  →" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Margin="0" IsEnabled="False" Click="ConvertFiles"/>
            </Grid>
            <TextBlock x:Name="RouteHint" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" Text="Original files are preserved. Existing outputs get a numbered filename."/>
          </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,22,0,12"><TextBlock Text="Conversion queue" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="Counts" Text="Ready when you are" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/></Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
              HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F8FAFC" RowHeight="32"
              HorizontalScrollBarVisibility="Disabled" SelectionChanged="JobSelected" Margin="10,6,10,0">
              <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#65768A"/><Setter Property="Padding" Value="9,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/></Style></DataGrid.ColumnHeaderStyle>
              <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,2"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.CellStyle>
              <DataGrid.Columns><DataGridTextColumn Header="FILE" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource QueueCellText}"/><DataGridTextColumn Header="FORMAT" Binding="{Binding FormatLabel}" Width="135" ElementStyle="{StaticResource QueueCellText}"/>
                <DataGridTemplateColumn Header="STATUS" Width="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                  <TextBlock Text="{Binding StatusLabel}" FontSize="12"/><ProgressBar Height="2" Margin="0,2,8,0" Maximum="100" Value="{Binding Progress}" Foreground="#087F8C" BorderThickness="0">
                    <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Progress}" Value="{x:Null}"><Setter Property="IsIndeterminate" Value="True"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                  </ProgressBar></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyQueue" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="⇄" FontSize="30" Foreground="#A2B9C6" HorizontalAlignment="Center"/><TextBlock Text="Your conversions will appear here" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
            <Border Grid.Row="1" BorderBrush="#E2E7EE" BorderThickness="0,1,0,0" Padding="12"><DockPanel>
              <Button Content="Clear finished" DockPanel.Dock="Right" Click="ClearHistory" Padding="10,7" Margin="0"/>
              <StackPanel Orientation="Horizontal"><Button x:Name="CancelButton" Content="Cancel" Click="CancelJob" Padding="10,7" IsEnabled="False"/><Button x:Name="RetryButton" Content="Retry" Click="RetryJob" Padding="10,7" IsEnabled="False"/><Button x:Name="RevealButton" Content="Show output" Click="RevealOutput" Padding="10,7" IsEnabled="False"/></StackPanel>
            </DockPanel></Border>
          </Grid>
        </Border>
      </Grid>
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Conversion engines" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="FileShift detects installed engines. Override a path for a portable or custom installation." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,16"/>
            <StackPanel x:Name="EngineRows"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Save paths &amp; rescan" Style="{StaticResource Primary}" Click="SaveEngines"/><Button Content="Run installer / add engines" Click="RunInstaller"/></StackPanel>
            <TextBlock Text="Engine availability does not guarantee every codec. Illustrator/EPS/PDF image input needs Ghostscript. Images export the first frame/page/artboard and flatten layers; CSV exports one sheet. Calibre reflows documents; PDF layout may change. No OCR or DRM removal." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="11"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Explorer &amp; system tray" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ShellStatus" Style="{StaticResource Muted}" Margin="0,10,0,12" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal"><Button Content="Enable Explorer menu" Click="EnableShell"/><Button Content="Remove Explorer menu" Click="DisableShell"/></StackPanel>
            <CheckBox x:Name="StartupCheck" Content="Start FileShift in the tray when I sign in" Margin="0,18,0,0" Click="StartupChanged"/>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="StatusMessage" Grid.Row="2" Text="Everything stays on your computer." Style="{StaticResource Muted}" FontSize="11" Margin="0,15,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>
  </Grid>
</Window>
